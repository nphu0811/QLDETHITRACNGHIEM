                <textFieldExpression><![CDATA[($P{TEN_LOP} == null ? "" : $P{TEN_LOP}) + "   |   " + ($P{TEN_MON} == null ? "" : $P{TEN_MON}) + "   |   Lần thi: " + ($P{LAN} == null ? "" : $P{LAN}.toString())]]></textFieldExpression>
