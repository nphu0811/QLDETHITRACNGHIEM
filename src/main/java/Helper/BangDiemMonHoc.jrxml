    <style name="CellScore" style="CellCenter" fontSize="10" isBold="true"/>
    <style name="Muted" style="Base" fontSize="7.5" forecolor="#707985"/>
    <style name="Signature" style="Base" fontSize="9" isBold="true" hTextAlign="Center"/>

    <!-- Keep the existing parameters and stored-procedure contract. -->
    <parameter name="MA_LOP" class="java.lang.String"/>
    <parameter name="MA_MH" class="java.lang.String"/>
    <parameter name="LAN" class="java.lang.Integer"/>
    <parameter name="TEN_LOP" class="java.lang.String"/>
    <parameter name="TEN_MON" class="java.lang.String"/>
    <parameter name="NGAY_THI" class="java.lang.String"/>
    <parameter name="NGUOI_LAP" class="java.lang.String"/>
    <parameter name="GIAO_VIEN" class="java.lang.String"/>
    <parameter name="LOGO_TRUONG" class="java.net.URL" isForPrompting="false">
        <defaultValueExpression><![CDATA[net.sf.jasperreports.engine.util.JRLoader.getResource("ptit-logo.png")]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[{call dbo.SP_BangDiemMonHocQuanLy($P{MA_LOP}, $P{MA_MH}, $P{LAN})}]]>
    </queryString>
    <field name="MASV" class="java.lang.String"/>
    <field name="HO" class="java.lang.String"/>
    <field name="TEN" class="java.lang.String"/>
    <field name="NGAYSINH" class="java.sql.Date"/>
