            <pen lineWidth="0.4" lineColor="#FFFFFF"/>
        </box>
    </style>
    <style name="Cell" style="Base" fontSize="8.5">
        <box leftPadding="7" rightPadding="7" topPadding="4" bottomPadding="4">
            <pen lineWidth="0.35" lineColor="#D5DAE1"/>
        </box>
    </style>
    <style name="CellCenter" style="Cell" hTextAlign="Center">
